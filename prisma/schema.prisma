// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id          String   @id @default(uuid())
  name        String
  image       String
  description String
  hotels      Hotel[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Hotel {
  id            String   @id @default(uuid())
  name          String
  image         String
  pricePerNight Int
  rating        Float
  description   String
  amenities     String   // Comma separated list for simplicity or JSON
  locationId    String
  location      Location @relation(fields: [locationId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Car {
  id           String   @id @default(uuid())
  name         String
  type         String   // SUV, Sedan, etc.
  seats        Int
  baseDayPrice Int
  image        String
  features     String   // Comma separated or JSON
  pricing      Pricing[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Pricing {
  id              String   @id @default(uuid())
  carId           String
  car             Car      @relation(fields: [carId], references: [id])
  location        String   // "Delhi Local", "Delhi Outstation", "Pune Local", etc.
  pricePerKm      Float
  basePrice       Float    // Price for 8 hrs or base package
  baseKm          Int      // Km included in base price (e.g., 80 km for 8 hrs)
  extraHourRate   Float
  driverAllowance Float
  description     String?  // e.g., "8 Hrs 80 Km"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
}

model Booking {
  id               String    @id @default(uuid())
  customerId       String?
  customer         User?     @relation(fields: [customerId], references: [id])
  customerName     String
  email            String
  phone            String
  type             String
  details          String
  amount           Float
  depositAmount    Float     @default(0)
  totalPaid        Float     @default(0)
  remainingAmount  Float     @default(0)
  status           String    @default("PENDING")
  paymentStatus    String    @default("UNPAID")
  bookingReference String    @unique @default(uuid())
  invoiceNumber    String?   @unique
  invoiceIssuedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
